#!/usr/bin/env bash
# Restart shell processes after a dotswap to match the target profile.
set -euo pipefail

profile="${1:-$(cat "$HOME/.local/state/dotswap-profile" 2>/dev/null || echo "")}"

kill_ambxst() {
  pkill -f "qs -p .*ambxst/shell.qml" 2>/dev/null || true
  pkill -f "axctl .*ambxst/axctl.toml" 2>/dev/null || true
  pkill -f "ambxst/scripts/loginlock.sh" 2>/dev/null || true
  pkill -f "ambxst/scripts/sleep_monitor.sh" 2>/dev/null || true
  pkill -x ambxst 2>/dev/null || true
}

kill_mako() {
  pkill -x mako 2>/dev/null || true
}

kill_quickshell_ii() {
  pkill -f "qs -c ii" 2>/dev/null || true
  pkill -f "quickshell -c ii" 2>/dev/null || true
}

# 43pr: waybar + dunst + the quickshell volume OSD / hyprquickpaper picker
kill_43pr() {
  pkill -x waybar 2>/dev/null || true
  pkill -x dunst 2>/dev/null || true
  pkill -f "qs -d -c volume-osd" 2>/dev/null || true
  pkill -f "quickshell -c hyprquickpaper" 2>/dev/null || true
}

start_ambxst() {
  pgrep -f "ambxst/shell.qml" >/dev/null && return
  command -v ambxst >/dev/null && setsid ambxst >/dev/null 2>&1 < /dev/null &
}

start_quickshell_ii() {
  pgrep -f "qs -c ii" >/dev/null && return
  setsid qs -c ii >/dev/null 2>&1 < /dev/null &
}

start_43pr() {
  if ! pgrep -x waybar >/dev/null; then
    command -v waybar >/dev/null && setsid waybar >/dev/null 2>&1 < /dev/null &
  fi
  if ! pgrep -x dunst >/dev/null; then
    command -v dunst >/dev/null && setsid dunst >/dev/null 2>&1 < /dev/null &
  fi
  if ! pgrep -f "qs -d -c volume-osd" >/dev/null; then
    command -v qs >/dev/null && setsid qs -d -c volume-osd >/dev/null 2>&1 < /dev/null &
  fi
}

# Hyprland picks its config format at STARTUP: `hyprland.lua` if present (Lua
# provider), else `hyprland.conf` (hyprlang). ambxst and 43pr are Lua rices,
# illogical/win11 are still .conf. chezmoi never deletes files, so after
# applying a .conf profile the previous rice's hyprland.lua would linger and win
# the next login – drop it then. NEVER drop it inside a running Lua session:
# `hyprctl reload` without hyprland.lua makes Hyprland write an autogenerated
# stub and every keybind is gone.
provider=$(hyprctl systeminfo 2>/dev/null | awk '/configProvider/ {print $2}')
drop_lua_config() {
  [ "${provider:-}" = lua ] && return 0
  rm -f "$HOME/.config/hypr/hyprland.lua"
}
target_format() {
  case "$1" in
    ambxst|43pr) echo lua ;;
    *)           echo conf ;;
  esac
}

case "$profile" in
  ambxst)
    kill_quickshell_ii
    kill_43pr
    kill_mako
    start_ambxst
    ;;
  illogical|win11)
    kill_ambxst
    kill_43pr
    kill_mako
    drop_lua_config
    start_quickshell_ii
    ;;
  43pr)
    kill_ambxst
    kill_quickshell_ii
    kill_mako
    start_43pr
    ;;
  *)
    echo "Unknown profile: $profile" >&2
    exit 1
    ;;
esac

hyprctl reload >/dev/null 2>&1 || true

# A .conf <-> Lua switch only fully takes effect after a re-login (the running
# compositor keeps the provider it started with).
if [ -n "${provider:-}" ] && [ "$(target_format "$profile")" != "$provider" ]; then
  notify-send "dotswap" "$profile uses a $(target_format "$profile") config, session runs $provider – log out and back in to finish" 2>/dev/null || true
fi
