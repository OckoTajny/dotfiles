#!/usr/bin/env bash
# dotswap - swap dotfile profiles via chezmoi multi-source
# Profiles live at ~/.local/share/chezmoi-<name>/

set -euo pipefail

PROFILE_FILE="$HOME/.local/state/dotswap-profile"
SRC_BASE="$HOME/.local/share"

TRACKED_CONFIG_DIRS=(
  alacritty ambxst btop cava fastfetch fish foot fuzzel hypr
  illogical-impulse kde-material-you-colors kitty lazygit mako matugen
  nvim quickshell rofi waybar wlogout
  # Sublime: only the user settings/keymap – Installed Packages are binaries
  # that Package Control re-fetches from the installed_packages list anyway
  sublime-text/Packages/User
)
TRACKED_LOCAL_SHARE_DIRS=(ambxst)
TRACKED_HOME_FILES=(.zshrc)

# Private/runtime data that must NEVER be committed (clipboard history holds
# copied secrets – tokens, passwords). Pruned from each snapshot. Paths are
# relative to a copied tracked dir under dot_local/share or dot_config.
# Globs, not names: Ambxst 1.3 split clipboard.db into clipboard-{pinned,unpinned}.db.
SENSITIVE_GLOBS=('clipboard*.db' 'clipboard-data*' 'keys.db' 'chats')

usage() {
  cat <<'EOF'
dotswap - swap dotfile profiles

Usage:
  dotswap status              Show current profile
  dotswap list                List available profiles
  dotswap use <profile>       Save current, switch to profile
  dotswap save                Re-snapshot current state into current profile
  dotswap diff <profile>      Show what would change
  dotswap snapshot <name>     Create new profile from current state

Profiles are at ~/.local/share/chezmoi-<name>/
EOF
}

current_profile() {
  if [[ -f "$PROFILE_FILE" ]]; then
    cat "$PROFILE_FILE"
  else
    echo "unknown"
  fi
}

list_profiles() {
  for d in "$SRC_BASE"/chezmoi-*; do
    [[ -d "$d" ]] && basename "$d" | sed 's/^chezmoi-//'
  done
}

profile_exists() {
  [[ -d "$SRC_BASE/chezmoi-$1" ]]
}

# Mirror current disk state into a profile source dir.
#
# Goes through `chezmoi add` rather than copying the target tree verbatim: a
# raw copy loses chezmoi's attribute prefixes, so a source file like
# literal_create_custom_config.lua (target: create_custom_config.lua) came back
# as create_custom_config.lua – which chezmoi then reads as the `create_`
# attribute and turns into a second target, custom_config.lua. One more
# snapshot later the source held both spellings and every `dotswap use`
# died with "inconsistent state". `chezmoi add` derives the right prefixes
# (literal_, executable_, private_, dot_) itself.
#
# Templates (*.tmpl) are left alone – the rendered target must not replace
# the template – and files that vanished from disk are forgotten, so the
# source still mirrors the desktop.
snapshot_path() {
  local src="$1" tgt="$2" tmpls prune=()
  if [[ ! -e "$tgt" && ! -L "$tgt" ]]; then
    chezmoi --source "$src" forget --force "$tgt" >/dev/null 2>&1 || true
    return
  fi
  # forget managed entries whose target is gone
  chezmoi --source "$src" managed --path-style=absolute --include=files,symlinks "$tgt" 2>/dev/null \
    | while IFS= read -r f; do
        [[ -e "$f" || -L "$f" ]] || chezmoi --source "$src" forget --force "$f" >/dev/null 2>&1 || true
      done
  if [[ -f "$tgt" || -L "$tgt" ]]; then
    chezmoi --source "$src" add --secrets ignore "$tgt"
    return
  fi
  # never snapshot private runtime data (clipboard history = copied secrets)
  for g in "${SENSITIVE_GLOBS[@]}"; do prune+=(-name "$g" -o); done
  tmpls=$(chezmoi --source "$src" managed --path-style=absolute --include=templates "$tgt" 2>/dev/null)
  find "$tgt" \( "${prune[@]}" -false \) -prune -o \( -type f -o -type l \) -print \
    | { grep -vxF "${tmpls:-/nonexistent}" || true; } \
    | xargs -r -d '\n' chezmoi --source "$src" add --secrets ignore
}

snapshot_to() {
  local profile="$1"
  local src="$SRC_BASE/chezmoi-$profile"
  mkdir -p "$src"

  for d in "${TRACKED_CONFIG_DIRS[@]}"; do
    snapshot_path "$src" "$HOME/.config/$d"
  done
  for d in "${TRACKED_LOCAL_SHARE_DIRS[@]}"; do
    snapshot_path "$src" "$HOME/.local/share/$d"
    # prune anything sensitive that an older, copy-based snapshot left behind
    for g in "${SENSITIVE_GLOBS[@]}"; do
      find "$src/dot_local/share" -name "$g" -exec rm -rf {} + 2>/dev/null || true
    done
  done
  for f in "${TRACKED_HOME_FILES[@]}"; do
    snapshot_path "$src" "$HOME/$f"
  done

  if [[ -d "$src/.git" ]]; then
    git -C "$src" add -A
    git -C "$src" commit -q -m "snapshot $(date -Iseconds)" 2>/dev/null || true
  fi
}

# Every file a profile manages under the tracked paths, absolute.
managed_files() {
  local src="$SRC_BASE/chezmoi-$1" paths=()
  for d in "${TRACKED_CONFIG_DIRS[@]}";      do paths+=("$HOME/.config/$d"); done
  for d in "${TRACKED_LOCAL_SHARE_DIRS[@]}"; do paths+=("$HOME/.local/share/$d"); done
  for f in "${TRACKED_HOME_FILES[@]}";       do paths+=("$HOME/$f"); done
  chezmoi --source "$src" managed --path-style=absolute --include=files,symlinks "${paths[@]}" 2>/dev/null | sort -u
}

# chezmoi apply only ever writes; it never removes what the previous profile
# put down. Left alone, ambxst's hyprland.lua would survive a switch to
# illogical (Hyprland then boots the wrong rice), and the next snapshot would
# bake it into the illogical branch for good. So before applying, drop the
# files the OUTGOING profile manages that the incoming one doesn't. Untracked
# runtime data (clipboard history, caches) is not managed by either, so it
# stays.
prune_foreign() {
  local from="$1" to="$2" f
  comm -23 <(managed_files "$from") <(managed_files "$to") | while IFS= read -r f; do
    rm -f "$f"
  done
  # tidy directories that are now empty (rmdir refuses non-empty ones)
  for d in "${TRACKED_CONFIG_DIRS[@]}"; do
    [[ -d "$HOME/.config/$d" ]] && find "$HOME/.config/$d" -depth -type d -empty -delete 2>/dev/null
  done
  return 0
}

apply_profile() {
  local profile="$1"
  local src="$SRC_BASE/chezmoi-$profile"
  chezmoi --source "$src" apply --force
}

cmd_use() {
  local profile="$1"
  profile_exists "$profile" || { echo "No profile '$profile'. Available:"; list_profiles; exit 1; }
  local cur
  cur=$(current_profile)
  if [[ "$cur" != "unknown" && "$cur" != "$profile" ]] && profile_exists "$cur"; then
    echo "Saving current state to '$cur'..."
    snapshot_to "$cur"
    prune_foreign "$cur" "$profile"
  fi
  echo "Applying '$profile'..."
  apply_profile "$profile"
  mkdir -p "$(dirname "$PROFILE_FILE")"
  echo "$profile" > "$PROFILE_FILE"
  echo "Now on: $profile"
  echo "Run 'hyprctl reload' or relogin for compositor changes."
}

cmd_save() {
  local cur
  cur=$(current_profile)
  [[ "$cur" != "unknown" ]] || { echo "No active profile set. Use 'dotswap use <name>' first."; exit 1; }
  profile_exists "$cur" || { echo "Current profile '$cur' missing source dir."; exit 1; }
  echo "Snapshotting current state to '$cur'..."
  snapshot_to "$cur"
  echo "Saved."
}

cmd_snapshot() {
  local name="$1"
  local src="$SRC_BASE/chezmoi-$name"
  [[ ! -d "$src" ]] || { echo "Profile '$name' exists. Use 'dotswap save' to update."; exit 1; }
  mkdir -p "$src"
  git -C "$src" init -q
  snapshot_to "$name"
  echo "Created profile '$name'."
}

case "${1:-}" in
  status)   echo "Current profile: $(current_profile)" ;;
  list)     list_profiles ;;
  use)      [[ -n "${2:-}" ]] || { usage; exit 1; }; cmd_use "$2" ;;
  save)     cmd_save ;;
  snapshot) [[ -n "${2:-}" ]] || { usage; exit 1; }; cmd_snapshot "$2" ;;
  diff)     [[ -n "${2:-}" ]] || { usage; exit 1; }; profile_exists "$2" || { echo "No profile '$2'"; exit 1; }; chezmoi --source "$SRC_BASE/chezmoi-$2" diff ;;
  -h|--help|help|"") usage ;;
  *)        echo "Unknown command: $1"; usage; exit 1 ;;
esac
