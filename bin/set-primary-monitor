#!/usr/bin/env bash
# set-primary-monitor — pick which monitor is "primary".
#
# Hyprland has no native primary flag, so primary = the monitor at origin 0x0
# (what Hyprland, XWayland `xrandr --primary`, and most apps treat as primary,
# and where workspace 1 lands). The chosen monitor is placed at 0x0 and the
# others laid out left→right to its right. Applied live via hyprctl and
# persisted to ~/.config/hypr/monitors.conf.
#
# Deps: hyprctl, jq, fuzzel (or set PICKER=rofi), notify-send. xrandr optional.
set -uo pipefail

CONF="$HOME/.config/hypr/monitors.conf"
PICKER=${PICKER:-fuzzel}

note() { notify-send -i video-display "Primary monitor" "$1" 2>/dev/null || printf '%s\n' "$1"; }

mons_json=$(hyprctl monitors -j 2>/dev/null) || { note "hyprctl not reachable"; exit 1; }
count=$(printf '%s' "$mons_json" | jq 'length')
[ "$count" -ge 1 ] || { note "No monitors detected"; exit 1; }

# menu lines: "name<TAB>label" — label shown, name is the key
menu=$(printf '%s' "$mons_json" | jq -r '.[] |
  "\(.name)\t\(.name) — \(.description) (\(.width)x\(.height)@\(.refreshRate|floor)Hz\(if .focused then ", focused" else "" end))"')

case "$PICKER" in
  fuzzel) sel=$(cut -f2 <<<"$menu" | fuzzel --dmenu --prompt "Primary> ") ;;
  rofi)   sel=$(cut -f2 <<<"$menu" | rofi -dmenu -p "Primary") ;;
  *)      sel=$(cut -f2 <<<"$menu" | "$PICKER") ;;
esac
[ -n "${sel:-}" ] || exit 0                       # cancelled
chosen=$(awk -F'\t' -v l="$sel" '$2==l{print $1; exit}' <<<"$menu")
[ -n "$chosen" ] || { note "Unknown selection"; exit 1; }

# ordered list: chosen first, then the rest in their current x order
readarray -t ordered < <(
  printf '%s' "$mons_json" | jq -r --arg c "$chosen" \
    '(map(select(.name==$c)) + (sort_by(.x) | map(select(.name!=$c)))) | .[].name'
)

# lay out left→right at y=0, advancing x by each monitor's logical width
x=0
lines=()
for name in "${ordered[@]}"; do
  read -r w h r scale < <(printf '%s' "$mons_json" | jq -r --arg n "$name" \
    '.[] | select(.name==$n) | "\(.width) \(.height) \(.refreshRate|floor) \(.scale)"')
  spec="$name,${w}x${h}@${r},${x}x0,${scale}"
  hyprctl keyword monitor "$spec" >/dev/null 2>&1
  lines+=("monitor=$spec")
  # logical width = physical / scale, rounded
  x=$(( x + $(awk -v w="$w" -v s="$scale" 'BEGIN{printf "%d", (w/s)+0.5}') ))
done

# persist: replace only the monitor= lines for the monitors we just moved;
# keep everything else, including monitor= lines for DISCONNECTED monitors
# (e.g. the dock's externals when running on the bare laptop) so their config
# survives.
connected=$(printf '%s\n' "${ordered[@]}" | sed 's/[].[^$*\/+?(){}|]/\\&/g' | paste -sd'|')
tmp=$(mktemp)
grep -vE "^[[:space:]]*monitor=(${connected})," "$CONF" 2>/dev/null > "$tmp" || true
printf '%s\n' "${lines[@]}" >> "$tmp"
mv "$tmp" "$CONF"

# XWayland apps that query a primary output (best-effort, no-op on pure Wayland)
command -v xrandr >/dev/null 2>&1 && xrandr --output "$chosen" --primary 2>/dev/null || true

note "$chosen is now primary (0×0)"
