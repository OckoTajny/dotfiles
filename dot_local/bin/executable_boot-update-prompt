#!/bin/bash
# Runs on Hyprland start: asks whether to update all packages and (if the
# dotfiles repo has new upstream commits) whether to pull + apply them.
# Runs in a floating kitty so you see progress / can enter sudo password.
sleep 6  # let Ambxst (notification daemon) and network come up

# --- dotfiles: check active dotswap profile source for upstream changes ---
PROFILE=$(cat "$HOME/.local/state/dotswap-profile" 2>/dev/null)
SRC="$HOME/.local/share/chezmoi-$PROFILE"
BRANCH="" DOTF_BEHIND=0
if [[ -n $PROFILE && -d $SRC/.git ]]; then
  if git -C "$SRC" fetch -q origin 2>/dev/null; then
    BRANCH=$(git -C "$SRC" branch --show-current)
    DOTF_BEHIND=$(git -C "$SRC" rev-list --count "HEAD..origin/$BRANCH" 2>/dev/null || echo 0)
  fi
fi
export PROFILE SRC BRANCH DOTF_BEHIND

kitty --class update-prompt --title "System update" -e bash -c '
  echo    "╭──────────────────────────────────────╮"
  echo    "│  Update all packages?                │"
  echo    "│  (yay -Syu --noconfirm)              │"
  echo    "╰──────────────────────────────────────╯"
  read -rp "  [y/N] " ans
  if [[ $ans == [yY]* ]]; then
    notify-send "System update" "⏳ Running yay -Syu…"
    if yay -Syu --noconfirm; then
      notify-send "System update" "✅ All packages updated"
    else
      notify-send -u critical "System update" "❌ Update failed — check the terminal"
      read -rp "Update failed. Enter to close… "
    fi
  else
    notify-send "System update" "⏭️ Update skipped"
  fi

  # --- dotfiles update prompt (only when upstream has new commits) ---
  if [[ ${DOTF_BEHIND:-0} -gt 0 ]]; then
    echo
    echo  "╭──────────────────────────────────────╮"
    printf "│  Dotfiles (%s): %s new commits\n" "$PROFILE" "$DOTF_BEHIND"
    echo  "╰──────────────────────────────────────╯"
    git -C "$SRC" log --oneline "HEAD..origin/$BRANCH" | head -10 | sed "s/^/    /"
    read -rp "  Pull and apply? [y/N] " dans
    if [[ $dans == [yY]* ]]; then
      notify-send "Dotfiles" "⏳ Updating profile $PROFILE…"
      dotswap save >/dev/null   # snapshot live state first — nothing can get lost
      if git -C "$SRC" pull --rebase --autostash origin "$BRANCH" \
         && chezmoi --source "$SRC" apply --force; then
        notify-send "Dotfiles" "✅ Profile $PROFILE updated (hyprctl reload / relogin for compositor changes)"
      else
        git -C "$SRC" rebase --abort 2>/dev/null
        notify-send -u critical "Dotfiles" "❌ Update failed (conflict?) — check $SRC"
        read -rp "Dotfiles update failed. Enter to close… "
      fi
    else
      notify-send "Dotfiles" "⏭️ Dotfiles update skipped"
    fi
  fi
'
