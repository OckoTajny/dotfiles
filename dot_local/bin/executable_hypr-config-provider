#!/usr/bin/env bash
# hypr-config-provider — switch Hyprland between the .conf and the Lua config,
# without ever leaving the machine without a config to boot into.
#
# Why this exists: Hyprland picks its config provider ONCE, at startup. A
# running hyprlang session that reloads will NOT fall back to hyprland.lua —
# and if hyprland.conf is missing at that moment it writes an autogenerated
# 18-line stub over it, taking every keybind with it. So the two configs live
# side by side and only the *presence of hyprland.lua* decides which one the
# next session uses (Lua wins when both exist). Switching is therefore just a
# rename, and it only takes effect on the next login — never mid-session.
#
#   hypr-config-provider status   what's running now / what boots next
#   hypr-config-provider lua      arm the Lua config  (hyprland.lua.staged -> hyprland.lua)
#   hypr-config-provider conf     back to .conf       (hyprland.lua -> hyprland.lua.staged)
#
# Rolling back a broken Lua session: `hypr-config-provider conf`, then LOG OUT
# and back in. Do not `hyprctl reload` to roll back — same stub trap in reverse.
set -uo pipefail

DIR="$HOME/.config/hypr"
LUA="$DIR/hyprland.lua"
STAGED="$DIR/hyprland.lua.staged"
CONF="$DIR/hyprland.conf"

note() { notify-send -i preferences-system "Hyprland config" "$1" 2>/dev/null || printf '%s\n' "$1"; }
die()  { printf 'error: %s\n' "$1" >&2; exit 1; }

running() { hyprctl systeminfo 2>/dev/null | sed -n 's/^configProvider: *//p'; }

next_boot() {
  if [ -f "$LUA" ]; then echo "lua ($LUA)"
  elif [ -f "$CONF" ]; then echo "conf ($CONF)"
  else echo "NOTHING — Hyprland would generate a stub config"
  fi
}

case "${1:-status}" in
  status)
    printf 'running now : %s\n' "$(running || echo 'not running')"
    printf 'next login  : %s\n' "$(next_boot)"
    [ -f "$CONF" ] || printf '\nWARNING: no hyprland.conf fallback present.\n'
    ;;

  lua)
    [ -f "$LUA" ] && { note "Lua config already armed — log out and back in"; exit 0; }
    [ -f "$STAGED" ] || die "no $STAGED to arm"
    # Never arm a config that doesn't parse. Hyprland decides parser by file
    # EXTENSION, so the staged copy has to be verified under a real *.lua name —
    # and next to the modules, because require() resolves from the config dir.
    probe="$DIR/.hypr-config-provider-probe.lua"
    cp "$STAGED" "$probe" || die "cannot write $probe"
    out=$(Hyprland --verify-config -c "$probe" 2>&1)
    rm -f "$probe"
    printf '%s\n' "$out" | grep -q '^config ok$' \
      || die "staged Lua config does not parse:
$(printf '%s\n' "$out" | sed -n '/Config parsing result/,$p' | tail -n +3)"
    [ -f "$CONF" ] || die "refusing to arm Lua without a $CONF fallback"
    mv "$STAGED" "$LUA" || die "rename failed"
    note "Lua config armed. Log out and back in. If it breaks: hypr-config-provider conf, then log in again."
    ;;

  conf)
    [ -f "$CONF" ] || die "no $CONF to fall back to"
    if [ -f "$LUA" ]; then
      mv "$LUA" "$STAGED" || die "rename failed"
    fi
    note "Back on the .conf config. Log out and back in (do NOT hyprctl reload)."
    ;;

  *)
    die "usage: ${0##*/} [status|lua|conf]"
    ;;
esac
