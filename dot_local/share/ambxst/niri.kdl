        focus-column-right
    } // Custom Bind 82
    Mod+Ctrl+l {
        focus-column-right
    } // Custom Bind 83
    Mod+Shift+Left {
        move-column-left
    } // Custom Bind 84
    Mod+Shift+h {
        move-column-left
    } // Custom Bind 85
    Mod+Shift+Right {
        move-column-right
    } // Custom Bind 86
    Mod+Shift+l {
        move-column-right
    } // Custom Bind 87
    Mod+Shift+Up {
        move-window-up
    } // Custom Bind 88
    Mod+Shift+k {
        move-window-up
    } // Custom Bind 89
    Mod+Shift+Down {
        move-window-down
    } // Custom Bind 90
    Mod+Shift+Down {
        move-window-down
    } // Custom Bind 91
    Mod+Shift+j {
        move-window-down
    } // Custom Bind 92
    Mod+Shift+j {
        move-window-down
    } // Custom Bind 93
    Mod+Alt+Right {
        set-column-width "+50"
    } // Custom Bind 94
    Mod+Alt+l {
        set-column-width "+50"
    } // Custom Bind 95
    Mod+Alt+Left {
        set-column-width "-50"
    } // Custom Bind 96
    Mod+Alt+h {
        set-column-width "-50"
    } // Custom Bind 97
    Mod+Alt+Down {
        set-window-height "+50"
    } // Custom Bind 98
    Mod+Alt+j {
        set-window-height "+50"
    } // Custom Bind 99
    Mod+Alt+Up {
        set-window-height "-50"
    } // Custom Bind 100
    Mod+Alt+k {
        set-window-height "-50"
    } // Custom Bind 101
}

// Skipped binds (no niri equivalent — wire these manually if needed):
//   Custom Bind 0 — exec (key "Super_L": niri fires binds on press, so binding the modifier key itself would trigger on every Super press and interfere with Super+key combos; niri has no press-Super-alone (release-based) bind support)
//   Custom Bind 50 — workspace (key "mouse_down" has no niri equivalent)
//   Custom Bind 51 — workspace (key "mouse_up" has no niri equivalent)
//   Custom Bind 56 — movewindow (dispatcher not supported in niri)
//   Custom Bind 57 — resizewindow (dispatcher not supported in niri)
//   Custom Bind 69 — togglespecialworkspace (dispatcher not supported in niri)
//   Custom Bind 71 — exec (key "switch:Lid Switch" has no niri equivalent)
//   Custom Bind 72 — exec (key "switch:on:Lid Switch" has no niri equivalent)
//   Custom Bind 73 — exec (key "switch:off:Lid Switch" has no niri equivalent)

// Generated by axctl (window rules)


// Layer rule "quickshell": not supported in niri: no_anim
// Layer rule "quickshell": not supported in niri: blur
// Layer rule "quickshell": not supported in niri: blur_popups
// Layer rule "quickshell": not supported in niri: ignore_alpha
// Layer rule "selection": not supported in niri: no_anim
// Layer rule "fabric": not supported in niri: blur
// Layer rule "^ambxst(:.*)?$": not supported in niri: no_anim; blur; blur_popups
layer-rule {
    match namespace="^ambxst:wallpaper$"
    place-within-backdrop true
}

