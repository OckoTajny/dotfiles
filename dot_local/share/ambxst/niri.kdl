// Generated by axctl (startup)
// niri has no exec-recurrent; exec-once maps to spawn-at-startup.

spawn-at-startup "ambxst"

// Generated by axctl
// Include this file from your niri config with: include "<this-file>"

layout {
    background-color "transparent"
    gaps 2
    focus-ring {
        off
    }
    border {
        on
        width 2
        active-color "#ddb9f7ff"
        inactive-color "#252126ff"
    }
}

overview {
    workspace-shadow {
        off
    }
}


window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}
// Not supported in niri static config: outer gaps (use inner gaps in niri); opacity (niri uses per-app window-rule opacity); blur (configure via blur {} block at top level in niri); shadow (configure per-app via window-rule shadow {})

// layout switch to "dwindle" is not supported by niri (it uses continuous scrolling)

// Generated by axctl (keybinds)

binds {
    Mod+D {
        spawn "ambxst" "run" "dashboard"
    } // Custom Bind 1
    Mod+A {
        spawn "ambxst" "run" "assistant"
    } // Custom Bind 2
    Mod+V {
        spawn "ambxst" "run" "clipboard"
    } // Custom Bind 3
    Mod+PERIOD {
        spawn "ambxst" "run" "emoji"
    } // Custom Bind 4
    Mod+N {
        spawn "ambxst" "run" "notes"
    } // Custom Bind 5
    Mod+T {
        spawn "ambxst" "run" "tmux"
    } // Custom Bind 6
    Mod+COMMA {
        spawn "ambxst" "run" "wallpapers"
    } // Custom Bind 7
    Mod+TAB {
        spawn "ambxst" "run" "overview"
    } // Custom Bind 8
    Mod+ESCAPE {
        spawn "ambxst" "run" "powermenu"
    } // Custom Bind 9
    Mod+Shift+C {
        spawn "ambxst" "run" "config"
    } // Custom Bind 10
    Mod+L {
        spawn "loginctl" "lock-session"
    } // Custom Bind 11
    Mod+S {
        spawn "ambxst" "run" "tools"
    } // Custom Bind 12
    Mod+Shift+S {
        spawn "ambxst" "run" "screenshot"
    } // Custom Bind 13
    Mod+Shift+R {
        spawn "ambxst" "run" "screenrecord"
    } // Custom Bind 14
    Mod+Shift+A {
        spawn "ambxst" "run" "lens"
    } // Custom Bind 15
    Mod+Alt+B {
        spawn "ambxst" "reload"
    } // Custom Bind 16
    Mod+Ctrl+Alt+B {
        spawn "ambxst" "quit"
    } // Custom Bind 17
    Mod+Shift+B {
