    XF86AudioPlay {
        spawn "playerctl" "play-pause"
    } // Custom Bind 58
    XF86AudioPrev {
        spawn "playerctl" "previous"
    } // Custom Bind 59
    XF86AudioNext {
        spawn "playerctl" "next"
    } // Custom Bind 60
    XF86AudioMedia repeat=false {
        spawn "playerctl" "play-pause"
    } // Custom Bind 61
    XF86AudioStop repeat=false {
        spawn "playerctl" "stop"
    } // Custom Bind 62
    XF86AudioRaiseVolume repeat=false {
        spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "10%+"
    } // Custom Bind 63
    XF86AudioLowerVolume repeat=false {
        spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "10%-"
    } // Custom Bind 64
    XF86AudioMute repeat=false {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    } // Custom Bind 65
    XF86MonBrightnessUp repeat=false {
        spawn "ambxst" "brightness" "+5"
    } // Custom Bind 66
    XF86MonBrightnessDown repeat=false {
        spawn "ambxst" "brightness" "-5"
    } // Custom Bind 67
    XF86Calculator {
        spawn "notify-send" "Soon"
    } // Custom Bind 68
    Mod+Alt+V {
        move-window-to-workspace "special"
    } // Custom Bind 70
    Mod+Up {
        focus-window-up
    } // Custom Bind 74
    Mod+Ctrl+k {
        focus-window-up
    } // Custom Bind 75
    Mod+Down {
        focus-window-down
    } // Custom Bind 76
    Mod+Ctrl+j {
        focus-window-down
    } // Custom Bind 77
    Mod+Left {
        focus-column-left
    } // Custom Bind 78
    Mod+Ctrl+z {
        focus-column-left
    } // Custom Bind 79
