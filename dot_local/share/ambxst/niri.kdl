// Generated by axctl (startup)
// niri has no exec-recurrent; exec-once maps to spawn-at-startup.

spawn-at-startup "ambxst"

// Generated by axctl
// Include this file from your niri config with: include "<this-file>"

layout {
    gaps 2
    border {
        width 2
        active-color "#ddb9f7ff"
        inactive-color "#252126ff"
    }
}

// Not supported in niri static config: outer gaps (use inner gaps in niri); border rounding (niri uses per-app window-rule geometry-corner-radius); opacity (niri uses per-app window-rule opacity); blur (configure via blur {} block at top level in niri); shadow (configure per-app via window-rule shadow {})

// layout switch to "dwindle" is not supported by niri (it uses continuous scrolling)

// Generated by axctl (keybinds)

binds {
    Mod+Super_L repeat=false {
        spawn "ambxst" "run" "launcher"
    } // Custom Bind 0
    Mod+D {
        spawn "ambxst" "run" "dashboard"
    } // Custom Bind 1
    Mod+A {
        spawn "ambxst" "run" "assistant"
    } // Custom Bind 2
    Mod+V {
        spawn "ambxst" "run" "clipboard"
    } // Custom Bind 3
    Mod+PERIOD {
        spawn "ambxst" "run" "emoji"
    } // Custom Bind 4
    Mod+N {
        spawn "ambxst" "run" "notes"
    } // Custom Bind 5
    Mod+T {
        spawn "ambxst" "run" "tmux"
    } // Custom Bind 6
    Mod+COMMA {
        spawn "ambxst" "run" "wallpapers"
    } // Custom Bind 7
    Mod+TAB {
        spawn "ambxst" "run" "overview"
    } // Custom Bind 8
    Mod+ESCAPE {
        spawn "ambxst" "run" "powermenu"
    } // Custom Bind 9
    Mod+Shift+C {
        spawn "ambxst" "run" "config"
    } // Custom Bind 10
    Mod+L {
        spawn "loginctl" "lock-session"
    } // Custom Bind 11
    Mod+S {
        spawn "ambxst" "run" "tools"
    } // Custom Bind 12
    Mod+Shift+S {
        spawn "ambxst" "run" "screenshot"
    } // Custom Bind 13
    Mod+Shift+R {
        spawn "ambxst" "run" "screenrecord"
    } // Custom Bind 14
    Mod+Shift+A {
        spawn "ambxst" "run" "lens"
    } // Custom Bind 15
    Mod+Alt+B {
        spawn "ambxst" "reload"
    } // Custom Bind 16
    Mod+Ctrl+Alt+B {
        spawn "ambxst" "quit"
    } // Custom Bind 17
    XF86AudioPlay {
        spawn "playerctl" "play-pause"
    } // Custom Bind 57
    XF86AudioPrev {
        spawn "playerctl" "previous"
    } // Custom Bind 58
    XF86AudioNext {
        spawn "playerctl" "next"
    } // Custom Bind 59
    XF86AudioMedia repeat=false {
        spawn "playerctl" "play-pause"
    } // Custom Bind 60
    XF86AudioStop repeat=false {
        spawn "playerctl" "stop"
    } // Custom Bind 61
    XF86AudioRaiseVolume repeat=false {
        spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "10%+"
    } // Custom Bind 62
    XF86AudioLowerVolume repeat=false {
        spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "10%-"
    } // Custom Bind 63
    XF86AudioMute repeat=false {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    } // Custom Bind 64
    XF86MonBrightnessUp repeat=false {
        spawn "ambxst" "brightness" "+5"
    } // Custom Bind 65
    XF86MonBrightnessDown repeat=false {
        spawn "ambxst" "brightness" "-5"
    } // Custom Bind 66
    XF86Calculator {
        spawn "notify-send" "Soon"
    } // Custom Bind 67
}

