#!/bin/sh
# Super+Shift+Escape: list every bind from the i3 config
awk '/^bind(sym|code)/ {
  sub(/ --whole-window/, "")
  key = $2; gsub(/\$mod/, "Super", key); gsub(/Mod1/, "Alt", key); sub(/button4$/, "scroll up", key); sub(/button5$/, "scroll down", key); sub(/button6$/, "scroll left", key); sub(/button7$/, "scroll right", key)
  if ($1 == "bindcode") { if (key ~ /\+201$/) sub(/201$/, "Copilot", key); else if (key ~ /\+202$/) sub(/202$/, "F24 (touchpad key)", key); else if (key ~ /52$/) sub(/52$/, "Y", key); else if (key ~ /53$/) sub(/53$/, "X", key); else { n = substr(key, length(key) - 1) - 9; sub(/1[0-9]$/, n % 10, key) } }
  $1 = $2 = ""; sub(/^ +(exec (--no-startup-id )?)?/, "")
  sub(/^\$term -e nvim$/, "LazyVim"); sub(/.*Toolbox\/scripts\/idea$/, "IntelliJ IDEA"); sub(/^\$term -e brrtfetch.*/, "terminal + brrtfetch"); sub(/^\$term$/, "terminal"); sub(/^\$rofi -show drun$/, "app launcher")
  sub(/.*i3\/kb$/, "switch us / cz layout"); sub(/.*i3\/max$/, "maximize (keeps the bar)"); sub(/.*i3\/shot$/, "screenshot region (file + clipboard)"); sub(/.*i3\/fn /, "fn: ")
  sub(/^move container to output /, "move window to monitor "); sub(/; focus output.*/, ""); sub(/^focus output /, "focus monitor ")
  sub(/^move container to workspace [0-9]+; /, "move window to "); sub(/^move container to workspace /, "move window (stay) to workspace "); sub(/.*ws -1$/, "previous workspace"); sub(/.*ws \+1$/, "next workspace"); sub(/.*cooldown i3-msg -q /, ""); sub(/.*i3\/keys$/, "this list"); sub(/.*i3\/power$/, "power menu")
  printf "%-24s %s\n", key, $0
}' ~/.config/i3/config | rofi -dmenu -i -p keys -theme ~/.config/i3/rofi.rasi -theme-str 'window { width: 760px; } listview { lines: 22; }'
