#!/usr/bin/env python3
# Fullscreen blinking low-battery alert: rainbow at full brightness, worse every % lower.
# Click to hide; closes itself once the charger is in. BATTERY_DIR overrides the battery (for testing).
import colorsys
import glob
import os
import signal
import subprocess
import tkinter as tk

BAT = os.environ.get("BATTERY_DIR") or sorted(glob.glob("/sys/class/power_supply/BAT*"))[0]


def rgb(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, s, v)
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def text(bg):
    r, g, b = (int(bg[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return "#000000" if .299 * r + .587 * g + .114 * b > .55 else "#ffffff"


# 20 blocks of 10: each block is a full hue wheel, alternating bright and deep shades.
# 20% uses the first block, every 1% lower adds another whole block, all 200 colors by 1%.
COLORS = []
for _block in range(20):
    for _slot in range(10):
        _bg = rgb(_slot / 10 + _block / 200, 1, 1 if _block % 2 == 0 else .55)
        COLORS.append((_bg, text(_bg)))
FONT = "JetBrainsMono Nerd Font"


def read(name):
    with open(f"{BAT}/{name}") as f:
        return f.read().strip()


root = tk.Tk()
root.overrideredirect(True)
root.attributes("-topmost", True)
w, h = root.winfo_screenwidth(), root.winfo_screenheight()
root.geometry(f"{w}x{h}+0+0")
big = tk.Label(root, font=(FONT, -(h // 4), "bold"))
small = tk.Label(root, font=(FONT, -(h // 16), "bold"), text="PLUG IN THE CHARGER, click to hide")
big.pack(expand=True, fill="both")
small.pack(fill="x", ipady=h // 20)
tick = 0

# full brightness while it's up, restored on close
brightness = subprocess.run(["brightnessctl", "get"], capture_output=True, text=True).stdout.strip()
subprocess.run(["brightnessctl", "-q", "set", "100%"])


closed = False


def close(_event=None):
    global closed
    if closed:
        return
    closed = True
    if brightness:
        subprocess.run(["brightnessctl", "-q", "set", brightness])
    root.destroy()


# restore brightness even when killed (battery-mode toggle, logout)
def _on_signal(_signum, _frame):
    root.after(0, close)


for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(_sig, _on_signal)


def blink():
    global tick
    if read("status") != "Discharging":
        close()
        return
    cap = int(read("capacity"))
    big["text"] = f"BATTERY {cap}%"
    # 20% -> 10 colors, every 1% lower adds 10 more, all 200 by 1%
    colors = COLORS[: min(len(COLORS), 10 * max(21 - cap, 1))]
    bg, fg = colors[tick % len(colors)]
    tick += 1
    for widget in (root, big, small):
        widget["bg"] = bg
    big["fg"] = small["fg"] = fg
    # one color on screen at a time, a new one every 0.1 s (as requested)
    root.after(100, blink)


root.bind("<Button>", close)
blink()
root.mainloop()
