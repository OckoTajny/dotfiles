#!/usr/bin/env python3
# Fullscreen blinking low-battery alert: random colors, shaking mega-warnings.
# Click to hide; closes itself once the charger is in. BATTERY_DIR overrides the battery (for testing).
import colorsys
import glob
import os
import random
import signal
import subprocess
import tkinter as tk

BAT = os.environ.get("BATTERY_DIR") or sorted(glob.glob("/sys/class/power_supply/BAT*"))[0]


def rgb(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, s, v)
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def text(bg):
    r, g, b = (int(bg[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return "#000000" if .299 * r + .587 * g + .114 * b > .55 else "#ffffff"


# 20 blocks of 10 hue-wheel colors, alternating bright and deep shades, then shuffled:
# 20% uses the first 10 random colors, every 1% lower adds 10 more, all 200 by 1%.
COLORS = []
for _block in range(20):
    for _slot in range(10):
        _bg = rgb(_slot / 10 + _block / 200, 1, 1 if _block % 2 == 0 else .55)
        COLORS.append((_bg, text(_bg)))
random.shuffle(COLORS)
FONT = "JetBrainsMono Nerd Font"

BIG_TEXT = (
    "⚠ BATTERY {cap}% ⚠",
    "PLUG IN\nTHE CHARGER",
    "!! LOW\nPOWER !!",
    "CHARGER\nNOW",
    "⚠ {cap}%\n⚠ {cap}% ⚠",
    "SYSTEM\nCRITICAL",
    "DO NOT\nIGNORE",
    "BATTERY\nDYING",
    "!! {cap}% !!\nCHARGE IT",
)
SMALL_TEXT = (
    "PLUG IN THE CHARGER · CLICK TO HIDE",
    "⚠  ⚠  ⚠   DO NOT IGNORE   ⚠  ⚠  ⚠",
    "BATTERY DYING — CHARGER, NOW",
    "THIS IS YOUR FINAL WARNING · CLICK TO HIDE",
    "!!! PLUG IT IN !!!",
    "CHARGER · CHARGER · CHARGER · CLICK TO HIDE",
)


def read(name):
    with open(f"{BAT}/{name}") as f:
        return f.read().strip()


root = tk.Tk()
root.overrideredirect(True)
root.attributes("-topmost", True)
w, h = root.winfo_screenwidth(), root.winfo_screenheight()
root.geometry(f"{w}x{h}+0+0")
frame = tk.Frame(root, highlightthickness=max(10, h // 70))
frame.pack(fill="both", expand=True)
top = tk.Label(frame, font=(FONT, -(h // 24), "bold"))
small = tk.Label(frame, font=(FONT, -(h // 16), "bold"), wraplength=int(w * .92))
big = tk.Label(frame, font=(FONT, -(h // 4), "bold"), justify="center", wraplength=int(w * .92))
top.pack(fill="x")
small.pack(side="bottom", fill="x", ipady=h // 20)
big.place(relx=.5, rely=.5, anchor="center")
tick = 0

# full brightness while it's up, restored on close
brightness = subprocess.run(["brightnessctl", "get"], capture_output=True, text=True).stdout.strip()
subprocess.run(["brightnessctl", "-q", "set", "100%"])


closed = False


def close(_event=None):
    global closed
    if closed:
        return
    closed = True
    if brightness:
        subprocess.run(["brightnessctl", "-q", "set", brightness])
    root.destroy()


# restore brightness even when killed (battery-mode toggle, logout)
def _on_signal(_signum, _frame):
    root.after(0, close)


for _sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(_sig, _on_signal)


def blink():
    global tick
    if read("status") != "Discharging":
        close()
        return
    cap = int(read("capacity"))
    # 20% -> 10 colors, every 1% lower adds 10 more, all 200 by 1%
    colors = COLORS[: min(len(COLORS), 10 * max(21 - cap, 1))]
    bg, fg = colors[tick % len(colors)]
    tick += 1

    # one background color at a time, but the text and layout go nuts
    big["text"] = random.choice(BIG_TEXT).format(cap=cap)
    small["text"] = random.choice(SMALL_TEXT)
    top["text"] = random.choice((
        "WARNING",
        "!!! WARNING !!!",
        "LOW BATTERY",
        " ".join(random.choice(("⚠", "!", "⚡", "☠")) for _ in range(random.randint(3, 9))),
    ))
    big["font"] = random.choice(((FONT, -(h // 4), "bold"), (FONT, -(h // 5), "bold"), (FONT, -(h // 6), "bold")))
    big["justify"] = random.choice(("left", "center", "right"))
    for widget in (root, frame, top, big, small):
        widget["bg"] = bg
    for widget in (top, big, small):
        widget["fg"] = fg
    frame["highlightbackground"] = frame["highlightcolor"] = fg
    # shake the huge text around
    big.place_configure(relx=.5 + random.uniform(-.02, .02), rely=.5 + random.uniform(-.015, .015))
    # one color on screen at a time, a new one every 0.1 s (as requested)
    root.after(100, blink)


root.bind("<Button>", close)
blink()
root.mainloop()
