#!/usr/bin/env python3
# Fullscreen blinking low-battery alert: rainbow at full brightness, worse every % lower.
# Click to hide; closes itself once the charger is in. BATTERY_DIR overrides the battery (for testing).
import glob
import os
import subprocess
import tkinter as tk

BAT = os.environ.get("BATTERY_DIR") or sorted(glob.glob("/sys/class/power_supply/BAT*"))[0]
COLORS = [  # (bg, fg); 20% uses the first two, every ~3% lower adds the next one
    ("#000000", "#ff0000"), ("#ff0000", "#ffffff"), ("#ffff00", "#ff00ff"), ("#00ff00", "#000000"),
    ("#00ffff", "#ff0000"), ("#0000ff", "#ffff00"), ("#ff00ff", "#00ff00"), ("#ffffff", "#ff0000"),
]
FONT = "JetBrainsMono Nerd Font"


def read(name):
    with open(f"{BAT}/{name}") as f:
        return f.read().strip()


root = tk.Tk()
root.overrideredirect(True)
root.attributes("-topmost", True)
w, h = root.winfo_screenwidth(), root.winfo_screenheight()
root.geometry(f"{w}x{h}+0+0")
big = tk.Label(root, font=(FONT, -(h // 4), "bold"))
small = tk.Label(root, font=(FONT, -(h // 16), "bold"), text="PLUG IN THE CHARGER, click to hide")
big.pack(expand=True, fill="both")
small.pack(fill="x", ipady=h // 20)
tick = 0

# full brightness while it's up, restored on close
brightness = subprocess.run(["brightnessctl", "get"], capture_output=True, text=True).stdout.strip()
subprocess.run(["brightnessctl", "-q", "set", "100%"])


def close(_event=None):
    if brightness:
        subprocess.run(["brightnessctl", "-q", "set", brightness])
    root.destroy()


def blink():
    global tick
    if read("status") != "Discharging":
        close()
        return
    cap = int(read("capacity"))
    big["text"] = f"BATTERY {cap}%"
    # every % lower is a bit worse: more colors and faster
    colors = COLORS[: min(len(COLORS), 2 + (20 - cap) // 3)]
    bg, fg = colors[tick % len(colors)]
    tick += 1
    for widget in (root, big, small):
        widget["bg"] = bg
    big["fg"] = small["fg"] = fg
    # 20% -> 395 ms, 10% -> 275 ms, 5% -> 215 ms, 1% -> 167 ms. 167 ms is the floor on
    # purpose: past 3 flashes/s full-screen flashing can trigger photosensitive seizures.
    root.after(167 + max(cap - 1, 0) * 12, blink)


root.bind("<Button>", close)
blink()
root.mainloop()
