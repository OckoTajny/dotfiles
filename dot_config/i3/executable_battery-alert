#!/usr/bin/env python3
# Huge blinking low-battery banner: blinks faster the lower the charge, click to hide,
# closes itself once the charger is in. BATTERY_DIR overrides the battery (for testing).
import glob
import os
import tkinter as tk

BAT = os.environ.get("BATTERY_DIR") or sorted(glob.glob("/sys/class/power_supply/BAT*"))[0]
RED, BLACK = "#ff2e56", "#000000"
FONT = "JetBrainsMono Nerd Font"


def read(name):
    with open(f"{BAT}/{name}") as f:
        return f.read().strip()


root = tk.Tk()
root.overrideredirect(True)
root.attributes("-topmost", True)
w, h = root.winfo_screenwidth(), root.winfo_screenheight()
bw, bh = int(w * 0.8), int(h * 0.5)
root.geometry(f"{bw}x{bh}+{(w - bw) // 2}+{(h - bh) // 2}")
big = tk.Label(root, font=(FONT, -(bh // 4), "bold"))
small = tk.Label(root, font=(FONT, -(bh // 14), "bold"), text="plug in the charger, click to hide")
big.pack(expand=True, fill="both")
small.pack(fill="x", ipady=bh // 20)
on = False


def blink():
    global on
    if read("status") != "Discharging":
        root.destroy()
        return
    cap = int(read("capacity"))
    big["text"] = f"BATTERY {cap}%"
    on = not on
    fg, bg = (BLACK, RED) if on else (RED, BLACK)
    for widget in (root, big, small):
        widget["bg"] = bg
    big["fg"] = small["fg"] = fg
    # 20% -> 570 ms, 5% -> 270 ms, 1% -> 190 ms. Floor keeps it under 3 flashes/s (photosensitive seizure limit).
    root.after(170 + cap * 20, blink)


root.bind("<Button>", lambda e: root.destroy())
blink()
root.mainloop()
