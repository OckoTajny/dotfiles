#!/bin/sh
# Low battery warnings: 20% normal, 5% critical (upower suspends at 2%). Once per drop, reset on charge.
b=$(ls -d /sys/class/power_supply/BAT* | head -n1)
warned=100
while :; do
  cap=$(cat "$b/capacity"); st=$(cat "$b/status")
  if [ "$st" != Discharging ]; then
    warned=100
  elif [ "$cap" -le 5 ] && [ "$warned" -gt 5 ]; then
    dunstify -u critical -h string:x-dunst-stack-tag:battery "Battery critical: $cap%" "Plug in now, the laptop suspends at 2%."; warned=5
  elif [ "$cap" -le 20 ] && [ "$warned" -gt 20 ]; then
    dunstify -u normal -h string:x-dunst-stack-tag:battery "Battery low: $cap%" "Plug in the charger soon."; warned=20
  fi
  sleep 60
done
