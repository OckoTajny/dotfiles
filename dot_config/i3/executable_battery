#!/bin/sh
# Low battery warning at every % from 20 down, since upower silently suspends at 2%.
# A dunst notification, or the fullscreen blinking battery-alert when opted in at install
# (~/.local/state/i3-battery-alert). Resets once charging.
b=$(ls -d /sys/class/power_supply/BAT* | head -n1)
flag=~/.local/state/i3-battery-alert
warned=100
while :; do
  cap=$(cat "$b/capacity"); st=$(cat "$b/status")
  if [ "$st" != Discharging ]; then
    warned=100
  elif [ "$cap" -le 20 ] && [ "$cap" -lt "$warned" ]; then
    if [ -f "$flag" ]; then
      pgrep -f 'python3 .*i3/battery-alert' >/dev/null || ~/.config/i3/battery-alert &
    else
      u=normal; [ "$cap" -le 5 ] && u=critical
      dunstify -u $u -h string:x-dunst-stack-tag:battery "Battery low: $cap%" "Plug in the charger."
    fi
    warned=$cap
  fi
  sleep 30
done
