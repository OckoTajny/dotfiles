# Simple i3, colors from VS Code "Hyper" theme, binds mirror niri
set $mod Mod4
set $term kitty -c ~/.config/kitty/kitty.conf -c ~/.config/i3/kitty.conf
set $rofi rofi -theme ~/.config/i3/rofi.rasi
font pango:JetBrainsMono Nerd Font Bold 10

#                       border  bg      text    indicator child_border
client.focused          #00a8ff #00a8ff #000000 #14fa50   #00a8ff
client.focused_inactive #2c313a #2c313a #d0d6e0 #2c313a   #2c313a
client.unfocused        #000000 #000000 #5c6370 #000000   #000000
client.urgent           #ff2e56 #ff2e56 #000000 #ff2e56   #ff2e56
default_border pixel 2
hide_edge_borders smart
focus_follows_mouse yes

# tap Super alone = Super+R (app launcher), held Super works as usual
exec --no-startup-id xcape -e 'Super_L=Super_L|r'
exec --no-startup-id touchegg
# wallpaper: ~/Pictures/Wallpapers/i3.jpg if present (downloaded, not in the repo), else the bundled one
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/Pictures/Wallpapers/i3.jpg || feh --no-fehbg --bg-fill ~/.config/i3/wall.jpg
# compositor only for VSync (no tearing when scrolling); /dev/null config skips /etc/xdg/picom.conf (fades, shadows)
exec --no-startup-id picom --config /dev/null --backend glx --vsync
exec --no-startup-id dunst -config ~/.config/i3/dunstrc
exec --no-startup-id nm-applet
exec --no-startup-id xss-lock -- i3lock -n -c 000000
exec --no-startup-id ~/.config/i3/gpu

bindsym $mod+Return exec $term -e brrtfetch -width 50 -height 50 -info 'fastfetch --logo-type none --color-keys magenta --color-title magenta' ~/brrtfetch/gifs/distro/linux/arch-purple-glitch-transparent.gif
bindsym $mod+t exec $term
bindsym $mod+c exec $term -e nvim
bindsym $mod+i exec ~/.local/share/JetBrains/Toolbox/scripts/idea
bindsym $mod+w exec zen-browser
bindsym $mod+e exec nautilus
bindsym $mod+b exec $term -e btop
bindsym $mod+r exec $rofi -show drun
bindsym $mod+space exec --no-startup-id ~/.config/i3/kb
bindsym --release Print exec --no-startup-id ~/.config/i3/shot
bindsym --release $mod+Shift+s exec --no-startup-id ~/.config/i3/shot

# Fn keys (volume, mic, brightness, touchpad, display), media keys
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/fn vol+
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/fn vol-
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/fn mute
bindsym XF86AudioMicMute exec --no-startup-id ~/.config/i3/fn mic
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/fn bri+
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/fn bri-
bindsym XF86TouchpadToggle exec --no-startup-id ~/.config/i3/fn touchpad
# touchpad key on newer laptops sends Ctrl+Super+F24 (keycode 202)
bindcode Ctrl+$mod+202 exec --no-startup-id ~/.config/i3/fn touchpad
bindsym XF86Display exec --no-startup-id ~/.config/i3/fn display
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
# Copilot key = Shift+Super+F23 (keycode 201), like Hyprland: Discord, with Ctrl: Spotify
bindcode $mod+Shift+201 exec --no-startup-id discord
bindcode Ctrl+$mod+Shift+201 exec --no-startup-id spotify

bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+d exec --no-startup-id ~/.config/i3/max
bindsym $mod+Shift+space floating toggle
floating_modifier $mod

bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym Ctrl+$mod+h focus left
bindsym Ctrl+$mod+j focus down
bindsym Ctrl+$mod+k focus up
bindsym Ctrl+$mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# scrolling like niri: Super+scroll = workspace, Super+sideways scroll or Super+Shift+scroll = window
bindsym --whole-window $mod+button4 exec --no-startup-id ~/.config/i3/cooldown ~/.config/i3/ws -1
bindsym --whole-window $mod+button5 exec --no-startup-id ~/.config/i3/cooldown ~/.config/i3/ws +1
bindsym --whole-window $mod+button6 exec --no-startup-id ~/.config/i3/cooldown i3-msg -q focus left
bindsym --whole-window $mod+button7 exec --no-startup-id ~/.config/i3/cooldown i3-msg -q focus right
bindsym --whole-window $mod+Shift+button4 exec --no-startup-id ~/.config/i3/cooldown i3-msg -q focus left
bindsym --whole-window $mod+Shift+button5 exec --no-startup-id ~/.config/i3/cooldown i3-msg -q focus right

# monitors
bindsym Ctrl+$mod+Left focus output left
bindsym Ctrl+$mod+Right focus output right
bindsym Ctrl+Shift+$mod+Left move container to output left; focus output left
bindsym Ctrl+Shift+$mod+Right move container to output right; focus output right

# workspaces (keycodes, so cz layout works too), like illogical-impulse:
# Super+N switch, Super+Shift+N move window and follow, Super+Alt+N move window and stay
bindcode $mod+10 workspace 1
bindcode $mod+11 workspace 2
bindcode $mod+12 workspace 3
bindcode $mod+13 workspace 4
bindcode $mod+14 workspace 5
bindcode $mod+15 workspace 6
bindcode $mod+16 workspace 7
bindcode $mod+17 workspace 8
bindcode $mod+18 workspace 9
bindcode $mod+19 workspace 10
bindcode $mod+Shift+10 move container to workspace 1; workspace 1
bindcode $mod+Shift+11 move container to workspace 2; workspace 2
bindcode $mod+Shift+12 move container to workspace 3; workspace 3
bindcode $mod+Shift+13 move container to workspace 4; workspace 4
bindcode $mod+Shift+14 move container to workspace 5; workspace 5
bindcode $mod+Shift+15 move container to workspace 6; workspace 6
bindcode $mod+Shift+16 move container to workspace 7; workspace 7
bindcode $mod+Shift+17 move container to workspace 8; workspace 8
bindcode $mod+Shift+18 move container to workspace 9; workspace 9
bindcode $mod+Shift+19 move container to workspace 10; workspace 10
bindcode $mod+Mod1+10 move container to workspace 1
bindcode $mod+Mod1+11 move container to workspace 2
bindcode $mod+Mod1+12 move container to workspace 3
bindcode $mod+Mod1+13 move container to workspace 4
bindcode $mod+Mod1+14 move container to workspace 5
bindcode $mod+Mod1+15 move container to workspace 6
bindcode $mod+Mod1+16 move container to workspace 7
bindcode $mod+Mod1+17 move container to workspace 8
bindcode $mod+Mod1+18 move container to workspace 9
bindcode $mod+Mod1+19 move container to workspace 10
# Super+Y/X (physical keys, same on us and cz) and Super+Left/Right: previous/next workspace number
bindcode $mod+52 exec --no-startup-id ~/.config/i3/ws -1
bindcode $mod+53 exec --no-startup-id ~/.config/i3/ws +1
bindsym $mod+Left exec --no-startup-id ~/.config/i3/ws -1
bindsym $mod+Right exec --no-startup-id ~/.config/i3/ws +1

bindsym $mod+l exec --no-startup-id loginctl lock-session
bindsym $mod+Shift+e exit
bindsym $mod+Shift+r restart

bar {
    status_command ~/.config/i3/status
    position top
    tray_output primary
    colors {
        background #000000
        statusline #9da5b4
        separator  #2c313a
        focused_workspace  #00a8ff #00a8ff #000000
        active_workspace   #2c313a #2c313a #d0d6e0
        inactive_workspace #000000 #000000 #5c6370
        urgent_workspace   #ff2e56 #ff2e56 #000000
        binding_mode       #ff2e56 #ff2e56 #000000
    }
}

# Super+Escape: power menu, Super+Shift+Escape: all keybinds (like niri)
bindsym $mod+Escape exec --no-startup-id ~/.config/i3/power
bindsym $mod+Shift+Escape exec --no-startup-id ~/.config/i3/keys
