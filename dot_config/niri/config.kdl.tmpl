// niri config — Ambxst-driven. Bar, launcher, wallpaper, lock, notifications
// all come from Ambxst (included below via `ambxst install niri`).
//
// Binds mirror ~/.config/hypr/custom/keybinds.lua + hyprland.lua OVERRIDES.
// The Ambxst include comes FIRST: niri `binds` are positional, later wins,
// so everything below beats Ambxst's generated defaults.
//
// chezmoi template (config.kdl.tmpl): niri can't expand ~/$HOME, so the
// home dir and the per-machine cursor are filled in by chezmoi. ~/.local/bin
// goes first so spawn-at-startup "ambxst" (from ambxst's niri.kdl) hits the
// single-instance guard wrapper, not the raw /usr/local/bin binary. Needed on
// the laptop (GDM + systemd session never sources ~/.profile).
{{- $cursor := "Bibata-Modern-Ice" }}{{ if eq .chezmoi.username "ocko" }}{{ $cursor = "Bibata-Modern-Classic" }}{{ end }}

environment {
    PATH "{{ .chezmoi.homeDir }}/.local/bin:/usr/local/bin:/usr/bin:/bin"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    XCURSOR_THEME "{{ $cursor }}"
    XCURSOR_SIZE "24"
}

// Polkit agent: first one present wins (desktop has polkit-kde, laptop polkit-gnome)
spawn-sh-at-startup "for a in /usr/lib/polkit-kde-authentication-agent-1 /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/libexec/polkit-gnome-authentication-agent-1; do [ -x \"$a\" ] && exec \"$a\"; done"
spawn-sh-at-startup "~/.local/bin/boot-update-prompt"
// Start on Czech (index 1); us stays first so binds resolve layout-independently
spawn-sh-at-startup "sleep 1; niri msg action switch-layout 1"

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot_%Y-%m-%d_%H.%M.%S.png"

// Outputs: every machine's monitors are listed, niri ignores the absent ones.
// Desktop: DP-2 (MSI 1440p/180) primary at 0,0; DP-3 (Philips 1080p/165) to
// the right, vertically centred ((1440-1080)/2 = 180). Laptop: eDP-1 + DP-1.
output "DP-2" {
    mode "2560x1440@180"
    position x=0 y=0
    variable-refresh-rate on-demand=true   // VRR only for windows that ask (games); always-on kills desktop animations
}
output "DP-3" {
    mode "1920x1080@165.003"
    position x=2560 y=180
    variable-refresh-rate on-demand=true   // VRR only for windows that ask (games); always-on kills desktop animations
}
output "DP-1" {
    mode "1920x1080@165.003"
    position x=2560 y=180
}
output "eDP-1" {
    mode "1920x1080@60"
    position x=0 y=0
}

input {
    keyboard {
        xkb {
            layout "us,cz"
        }
        numlock
        repeat-delay 250
        repeat-rate 35
    }
    touchpad {
        tap
        natural-scroll
        dwt
        scroll-factor 0.5
        accel-profile "flat"   // no acceleration curve
        accel-speed 0.0        // -1.0 slow .. 1.0 fast
    }
    mouse {
        accel-profile "flat"   // no acceleration (same as Hyprland)
        accel-speed 0.0        // sensitivity: -1.0 (slow) .. 1.0 (fast); tune here
    }
    focus-follows-mouse
    workspace-auto-back-and-forth
}

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "{{ $cursor }}"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 5000
}

// Boot update prompt: floating, centred (mirrors hypr custom/rules.lua)
window-rule {
    match app-id="^update-prompt$"
    open-floating true
    default-column-width { fixed 640; }
    default-window-height { fixed 420; }
}
// JetBrains: no initial focus on the empty splash/popup windows
window-rule {
    match app-id="^jetbrains-" title="^(|\\s|win\\d+)$"
    open-focused false
}
// Games: real fullscreen
window-rule {
    match app-id="^(cs2|steam_app_\\d+)$"
    open-fullscreen true
    variable-refresh-rate true
}

// Ambxst (bar, theme, default binds). Must stay ABOVE the binds block.
include "~/.local/share/ambxst/niri.kdl"

binds {
    Mod+Shift+Escape { show-hotkey-overlay; }
    Mod+Shift+E      { quit; }
    Ctrl+Mod+Slash   { spawn-sh "xdg-open ~/.config/niri/config.kdl"; }

    // ---- Apps (Super+C/I = IDEA, overrides Ambxst's Mod+C close-window)
    Mod+Return hotkey-overlay-title="Terminal + brrtfetch" { spawn-sh "kitty -e brrtfetch -width 50 -height 50 -info \"fastfetch --logo-type none --color-keys magenta --color-title magenta\" ~/brrtfetch/gifs/distro/linux/arch-purple-glitch-transparent.gif"; }
    Mod+T            { spawn "kitty"; }                       // beats Ambxst tmux selector
    Ctrl+Alt+T       { spawn "kitty"; }
    Mod+E            { spawn "nautilus"; }
    Mod+W            { spawn "zen-browser"; }
    Mod+C            { spawn-sh "~/.local/share/JetBrains/Toolbox/scripts/idea"; }
    Mod+I            { spawn-sh "~/.local/share/JetBrains/Toolbox/scripts/idea"; }
    Mod+O            { spawn "flatpak" "run" "org.onlyoffice.desktopeditors"; }
    Mod+B            { spawn "kitty" "-e" "btop"; }
    Mod+Shift+C      { spawn-sh "kitty --class claude-code --directory ~ -e ~/.local/bin/claude --dangerously-skip-permissions"; }
    Mod+Shift+T      { spawn "ambxst" "run" "tools"; }
    Shift+Mod+F23      { spawn "discord"; }                  // Copilot key -> Discord
    Ctrl+Shift+Mod+F23 { spawn "spotify"; }                  // Ctrl+Copilot -> Spotify

    // ---- Window
    Mod+Q            { close-window; }
    Mod+MouseMiddle  { close-window; }
    Alt+F4           { close-window; }
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+Shift+Space  { toggle-window-floating; }
    Mod+Space        { spawn "ambxst" "run" "launcher"; }   // Hyprland had Super tap; niri has no release binds
    Mod+R            { switch-preset-column-width; }
    Alt+Tab          { focus-window-previous; }

    // ---- Utilities
    Mod+Y            { spawn-sh "~/.local/bin/voice-to-text"; }                   // dictation (Y us / Z cz)
    Mod+Shift+Z      { spawn-sh "~/.local/bin/voice-to-text large-v3-turbo"; }    // accurate model (beats Ambxst ws-prev)
    Ctrl+Mod+Space   { spawn-sh "~/.local/bin/kb-toggle"; }                       // us <-> cz + notify (Mod+Space = Ambxst toggle floating since 1.3.7)
    Mod+P            { spawn-sh "~/.local/bin/sudo-passwd-toggle"; }

    // ---- dotswap (only niri <-> ambxst make sense inside a niri session)
    Ctrl+Mod+P            { spawn-sh "~/.local/bin/dotswap use win11 && ~/.local/bin/dotswap-postapply win11"; }
    Ctrl+Shift+Mod+Right  { spawn-sh "~/.local/bin/dotswap-cycle next"; }
    Ctrl+Shift+Mod+Left   { spawn-sh "~/.local/bin/dotswap-cycle prev"; }

    // ---- Screenshots (Print = Ambxst region UI, Ctrl = screen to file, Shift = screen to clipboard)
    Print            { spawn "ambxst" "run" "screenshot"; }
    Ctrl+Print       { screenshot-screen; }
    Shift+Print      { screenshot-screen write-to-disk=false; }

    // ---- Workspaces: Ctrl+Alt+N move (cz muscle memory) + numpad
    // cz layout: key 1 = "plus", an ASCII keysym, so niri matches it directly and
    // never falls back to the us layout (2..0 = ě š č... do). Mirror Mod+1 binds.
    // Held Mod+N: key repeat + workspace-auto-back-and-forth flip-flopped
    // between workspaces. Override Ambxst's Mod+N with repeat=false.
    Mod+1 repeat=false { focus-workspace 1; }
    Mod+2 repeat=false { focus-workspace 2; }
    Mod+3 repeat=false { focus-workspace 3; }
    Mod+4 repeat=false { focus-workspace 4; }
    Mod+5 repeat=false { focus-workspace 5; }
    Mod+6 repeat=false { focus-workspace 6; }
    Mod+7 repeat=false { focus-workspace 7; }
    Mod+8 repeat=false { focus-workspace 8; }
    Mod+9 repeat=false { focus-workspace 9; }
    Mod+0 repeat=false { focus-workspace 10; }
    Mod+Plus repeat=false { focus-workspace 1; }
    Mod+Shift+Plus { move-window-to-workspace 1; }
    Mod+Alt+Plus   { move-window-to-workspace 1 focus=false; }
    Ctrl+Alt+Plus  { move-window-to-workspace 1; }
    Ctrl+Alt+1 { move-window-to-workspace 1; }
    Ctrl+Alt+2 { move-window-to-workspace 2; }
    Ctrl+Alt+3 { move-window-to-workspace 3; }
    Ctrl+Alt+4 { move-window-to-workspace 4; }
    Ctrl+Alt+5 { move-window-to-workspace 5; }
    Ctrl+Alt+6 { move-window-to-workspace 6; }
    Ctrl+Alt+7 { move-window-to-workspace 7; }
    Ctrl+Alt+8 { move-window-to-workspace 8; }
    Ctrl+Alt+9 { move-window-to-workspace 9; }
    Ctrl+Alt+0 { move-window-to-workspace 10; }
    Mod+KP_1 repeat=false { focus-workspace 1; }
    Mod+KP_2 repeat=false { focus-workspace 2; }
    Mod+KP_3 repeat=false { focus-workspace 3; }
    Mod+KP_4 repeat=false { focus-workspace 4; }
    Mod+KP_5 repeat=false { focus-workspace 5; }
    Mod+KP_6 repeat=false { focus-workspace 6; }
    Mod+KP_7 repeat=false { focus-workspace 7; }
    Mod+KP_8 repeat=false { focus-workspace 8; }
    Mod+KP_9 repeat=false { focus-workspace 9; }
    Mod+KP_0 repeat=false { focus-workspace 10; }
    Mod+Shift+KP_1 { move-window-to-workspace 1; }
    Mod+Shift+KP_2 { move-window-to-workspace 2; }
    Mod+Shift+KP_3 { move-window-to-workspace 3; }
    Mod+Shift+KP_4 { move-window-to-workspace 4; }
    Mod+Shift+KP_5 { move-window-to-workspace 5; }
    Mod+Shift+KP_6 { move-window-to-workspace 6; }
    Mod+Shift+KP_7 { move-window-to-workspace 7; }
    Mod+Shift+KP_8 { move-window-to-workspace 8; }
    Mod+Shift+KP_9 { move-window-to-workspace 9; }
    Mod+Shift+KP_0 { move-window-to-workspace 10; }
    Mod+Alt+KP_1 { move-window-to-workspace 1 focus=false; }
    Mod+Alt+KP_2 { move-window-to-workspace 2 focus=false; }
    Mod+Alt+KP_3 { move-window-to-workspace 3 focus=false; }
    Mod+Alt+KP_4 { move-window-to-workspace 4 focus=false; }
    Mod+Alt+KP_5 { move-window-to-workspace 5 focus=false; }
    Mod+Alt+KP_6 { move-window-to-workspace 6 focus=false; }
    Mod+Alt+KP_7 { move-window-to-workspace 7 focus=false; }
    Mod+Alt+KP_8 { move-window-to-workspace 8 focus=false; }
    Mod+Alt+KP_9 { move-window-to-workspace 9 focus=false; }
    Mod+Alt+KP_0 { move-window-to-workspace 10 focus=false; }

    // Scroll-wheel workspace switch (Hyprland Super+mouse_down/up)
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    // Mouse stand-ins for niri touchpad gestures (desktop has no touchpad):
    // 3-finger horizontal swipe = column scroll, 4-finger vertical = overview.
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { focus-column-left; }
    Mod+WheelScrollRight      cooldown-ms=150 { focus-column-right; }   // tilt wheel
    Mod+WheelScrollLeft       cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+WheelScrollDown  cooldown-ms=150 { move-column-right; }
    Mod+Ctrl+WheelScrollUp    cooldown-ms=150 { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+MouseForward { toggle-overview; }            // side button = 4-finger swipe
    Mod+MouseBack    { focus-workspace-previous; }
}

// OVERRIDES
// Anything below also beats Ambxst.
